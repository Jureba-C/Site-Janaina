{
  "name": "site-janaina-server",
  "version": "1.0.0",
  "private": true,
  "description": "Loja online com vitrine, carrinho, frete (Melhor Envio), pagamento (Mercado Pago), acompanhamento de pedido e painel administrativo.",
  "main": "server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "sem-comentarios": "node scripts/sem-comentarios.js",
    "verificar": "node scripts/sem-comentarios.js && node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "aplicar-marca": "node scripts/aplicar-marca.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mercadopago": "^2.0.15",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "acorn": "^8.19.0"
  }
}
